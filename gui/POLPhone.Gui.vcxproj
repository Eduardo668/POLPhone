  <!--
    The Windows App SDK 1.6 PRI lists NoiseAsset_256X256_PNG.png, while the
    self-contained MSIX contains NoiseAsset_256x256_PNG.png. NTFS normally
    hides that difference, but WSL UNC directories are case-sensitive.
  -->
  <Target Name="NormalizeWinAppSdkNoiseAssetCase"
          BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory
          Remove="@(_SourceItemsToCopyToOutputDirectory)"
          Condition="'%(_SourceItemsToCopyToOutputDirectory.Filename)%(_SourceItemsToCopyToOutputDirectory.Extension)' == 'NoiseAsset_256X256_PNG.png'" />
      <_SourceItemsToCopyToOutputDirectory Include="$(IntDir)MsixContent\Microsoft.UI.Xaml\Assets\NoiseAsset_256x256_PNG.png">
        <TargetPath>Microsoft.UI.Xaml\Assets\NoiseAsset_256X256_PNG.png</TargetPath>
      </_SourceItemsToCopyToOutputDirectory>
      <_SourceItemsToCopyToOutputDirectory
          Remove="@(_SourceItemsToCopyToOutputDirectory)"
          Condition="'%(_SourceItemsToCopyToOutputDirectory.Filename)%(_SourceItemsToCopyToOutputDirectory.Extension)' == 'Microsoft.ui.xaml.dll'" />
      <_SourceItemsToCopyToOutputDirectory Include="$(IntDir)MsixContent\Microsoft.ui.xaml.dll">
        <TargetPath>Microsoft.UI.Xaml.dll</TargetPath>
      </_SourceItemsToCopyToOutputDirectory>
    </ItemGroup>
  </Target>
  <Target Name="CopyPOLPhoneCore" AfterTargets="Build">
    <Error Condition="!Exists('$(ProjectDir)..\build\$(Configuration)\polphone_core_runtime.dll')"
           Text="polphone_core_runtime.dll não encontrado. Compile primeiro o motor com scripts\build.ps1 -Config $(Configuration)." />
    <Copy SourceFiles="$(ProjectDir)..\build\$(Configuration)\polphone_core_runtime.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>
