/*
 * POLPhone - configuração do pjproject 2.17 para o MVP Windows x64.
 * Este arquivo é copiado por scripts/setup-pjproject.ps1 para
 * pjlib/include/pj/config_site.h. Não edite o submodule diretamente.
 */
#ifndef POLPHONE_CONFIG_SITE_H
#define POLPHONE_CONFIG_SITE_H

/* MVP somente áudio. */
#define PJMEDIA_HAS_VIDEO                         0

/* MVP sem TLS/OpenSSL. */
#define PJSIP_HAS_TLS_TRANSPORT                   0
#define PJ_HAS_SSL_SOCK                           0

/* PCMU/PCMA (G.711) e G.722 permanecem habilitados. */
#define PJMEDIA_HAS_G711_CODEC                    1
#define PJMEDIA_HAS_G722_CODEC                    1

/* Codecs compressivos ou desnecessários ao experimento. */
#define PJMEDIA_HAS_PASSTHROUGH_CODECS            0
#define PJMEDIA_HAS_GSM_CODEC                     0
#define PJMEDIA_HAS_SPEEX_CODEC                   0
#define PJMEDIA_HAS_ILBC_CODEC                    0
#define PJMEDIA_HAS_G7221_CODEC                   0
#define PJMEDIA_HAS_OPUS_CODEC                    0
#define PJMEDIA_HAS_L16_CODEC                     0
#define PJMEDIA_HAS_OPENCORE_AMRNB_CODEC          0
#define PJMEDIA_HAS_OPENCORE_AMRWB_CODEC          0
#define PJMEDIA_HAS_SILK_CODEC                    0
#define PJMEDIA_HAS_BCG729                        0
#define PJMEDIA_HAS_LYRA_CODEC                    0

/* Áudio nativo do Windows; WMME é o backend padrão do MVP. */
#define PJMEDIA_AUDIO_DEV_HAS_WMME                1
#define PJMEDIA_AUDIO_DEV_HAS_PORTAUDIO           0
#define PJMEDIA_AUDIO_DEV_HAS_WASAPI              0

/* Rede e limites do MVP. */
#define PJ_HAS_IPV6                               1
#define PJSUA_MAX_CALLS                           4
#define PJSUA_MAX_ACC                             2

/* Diagnóstico de campo também em Release. */
#define PJ_LOG_MAX_LEVEL                          5

#endif /* POLPHONE_CONFIG_SITE_H */
