{
  "$schema": "./polphone.config.schema.json",
  "sip": {
    "idUri": "sip:REPLACE_ME@REPLACE_ME.invalid",
    "displayName": "Operador POL",
    "registrarUri": "sip:REPLACE_ME.invalid:5060",
    "realm": "*",
    "username": "REPLACE_ME",
    "authUsername": "REPLACE_ME",
    "password": "REPLACE_ME",
    "domain": "REPLACE_ME.invalid",
    "proxyUri": "",
    "regTimeoutSec": 300,
    "regRetryIntervalSec": 10,
    "registerOnStartup": true
  },
  "network": {
    "localPort": 0,
    "boundAddress": "",
    "transport": "udp"
  },
  "audio": {
    "captureDevice": "",
    "playbackDevice": "",
    "clockRate": 8000,
    "channelCount": 1,
    "ptimeMs": 20,
    "ecTailMs": 200,
    "quality": 8,
    "noVad": true
  },
  "codecs": {
    "priority": {
      "PCMU/8000/1": 254,
      "PCMA/8000/1": 253,
      "G722/16000/1": 100,
      "speex/8000/1": 0,
      "iLBC/8000/1": 0,
      "GSM/8000/1": 0
    }
  },
  "dtmf": {
    "defaultMethod": "rfc4733",
    "durationMs": 160,
    "gapMs": 100,
    "volumeDbm0": -10,
    "localFeedback": false,
    "logDigits": false
  },
  "logging": {
    "consoleLevel": 4,
    "fileLevel": 5,
    "directory": "logs",
    "maxFileMB": 50,
    "sipMessageTrace": true
  },
  "behavior": {
    "ringtoneEnabled": true,
    "topmostOnIncomingCall": false
  }
}
