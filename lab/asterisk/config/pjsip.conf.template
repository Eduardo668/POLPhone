[transport-lab-udp]
type=transport
protocol=udp
bind=0.0.0.0:5061
external_signaling_address=${LAB_ADVERTISED_IP}
external_signaling_port=${LAB_PJSIP_HOST_PORT}
external_media_address=${LAB_ADVERTISED_IP}
local_net=127.0.0.0/8
allow_reload=no

[2001]
type=endpoint
transport=transport-lab-udp
context=from-lab
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=auto_info
auth=auth-2001
aors=2001

[auth-2001]
type=auth
auth_type=userpass
username=2001
password=${LAB_PJSIP_2001_SECRET}

[2001]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30
